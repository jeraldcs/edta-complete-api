# Optional API key. When set, POST endpoints require header: X-API-Key: <value>
# Leave unset for local demo mode (no auth).
EDTA_API_KEY=

# Comma-separated CORS origins. Use * for local development.
EDTA_CORS_ORIGINS=*

# Optional OpenAI integration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Persistent store paths (defaults shown)
EDTA_DB_PATH=data/edta.db
EXPERIENCE_MEMORY_FILE=data/experience_memory.json
FEEDBACK_STORE_FILE=data/feedback_events.json
DISTILLED_SLM_FILE=data/distilled_slm_memory.json
PROFILE_LOOKUP_FILE=data/customer_profiles.json
TAPL_POLICY_FILE=config/tapl_policies.yaml

# Hybrid AI Orchestration Engine
HAOE_LLM_COST_BUDGET=10.0
HAOE_LLM_FAILURE_THRESHOLD=3

# Profile lookup adapter: json_file
PROFILE_LOOKUP_ADAPTER=json_file

# Rate limiting (requests/minute per client IP; 0 disables)
EDTA_RATE_LIMIT_PER_MINUTE=120
EDTA_WEBHOOK_TIMEOUT_SECONDS=5.0

# Runtime environment: development | production
EDTA_ENVIRONMENT=development

# Structured logging: json | text
EDTA_LOG_LEVEL=INFO
EDTA_LOG_FORMAT=json

# Prometheus metrics at GET /metrics
EDTA_METRICS_ENABLED=true

# Error responses: auto | true | false
# auto hides internal exception details when EDTA_ENVIRONMENT=production
EDTA_EXPOSE_ERROR_DETAILS=auto

# Optional OpenTelemetry tracing (requires requirements-observability.txt)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=edta-api
OTEL_EXPORTER_OTLP_ENDPOINT=
